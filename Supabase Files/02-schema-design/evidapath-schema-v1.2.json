          }
        },
        "duration_years": {
          "type": "number"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "last_checked": {
          "$ref": "#/$defs/iso_date"
        },
        "verification_status": {
          "$ref": "#/$defs/verification_status"
        },
        "record_status": {
          "$ref": "#/$defs/record_status"
        },
        "extension_metadata": {
          "$ref": "#/$defs/extension_metadata"
        },
