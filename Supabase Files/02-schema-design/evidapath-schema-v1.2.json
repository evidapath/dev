            "string",
            "null"
          ]
        },
        "program_pathway_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "estimated_living_costs_annual": {
                "type": "number"
              }
            }
          },
          "then": {
            "properties": {
              "living_cost_source_basis": {
                "type": "object"
              }
            }
          }
        }
      ]
